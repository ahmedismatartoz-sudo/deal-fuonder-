# Configure real values only in a private environment or hosting secret manager.
# Copy the Session pooler URI from the Supabase Connect panel, port 5432.
# A database password is required, not a Supabase publishable/anon API key.
DEAL_FINDER_DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_PASSWORD@REPLACE_SESSION_POOLER_HOST:5432/postgres?sslmode=require
DEAL_FINDER_API_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
DEAL_FINDER_MODE=production
# Set these only on the collector service. Configure source tasks in Apify.
APIFY_API_TOKEN=REPLACE_WITH_PRIVATE_APIFY_TOKEN
DEAL_FINDER_COLLECTION_CONFIG={"tasks":[]}
# Optional native collector; no Apify token required for this source.
DEAL_FINDER_AUTOSCOUT24_CONFIG={}
